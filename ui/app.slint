import { Theme } from "theme.slint";

export struct ConversationItem {
    id: string,
    title: string,
    subtitle: string,
    avatar_letter: string,
    has_avatar: bool,
    avatar_image: image,
    last_message: string,
    timestamp: string,
    is_bot: bool,
    is_online: bool,
    bubble_color: color,
}

export struct MessageItem {
    id: string,
    content: string,
    timestamp: string,
    is_me: bool,
    bubble_color: color,
    has_media: bool,
    media_image: image,
    show_sender: bool,
    sender_name: string,
    is_read: bool,
    is_separator: bool,
    separator_text: string,
}

export struct BotCardItem {
    id: string,
    name: string,
    bio: string,
    avatar_letter: string,
    has_avatar: bool,
    avatar_image: image,
    bubble_color: color,
}

export struct PersonCardItem {
    id: string,
    username: string,
    subtitle: string,
    avatar_letter: string,
    has_avatar: bool,
    avatar_image: image,
    is_online: bool,
}

export component MainWindow inherits Window {
    title: "RtText";
    icon: @image-url("../assets/icons/bead.png");
    width: 1040px;
    height: 680px;
    background: Theme.background;
    default-font-size: 13px;

    // 1. Auth & Session State
    in-out property <bool> is-logged-in: false;
    in-out property <string> auth-mode: "login"; // "login" or "signup"
    in-out property <string> auth-email: "";
    in-out property <string> auth-password: "";
    in-out property <string> auth-username: "";
    in-out property <string> auth-error: "";
    in-out property <bool> auth-busy: false;
    in-out property <bool> show-email-auth: false;

    // 2. Navigation State
    in-out property <string> active-nav: "chats"; // "chats", "discover", "profile"
    in-out property <string> discover-subnav: "characters"; // "characters", "people"
    in-out property <string> search-query: "";

    // 3. User Appearance & Account
    in-out property <color> user-accent-color: Theme.accent-amber;
    in-out property <string> user-accent-id: "amber";
    in-out property <string> current-username: "User";
    in-out property <int> bead-balance: 0;
    in-out property <bool> user-has-avatar: false;
    in-out property <image> user-avatar-image;

    // 4. Active Chat State
    in-out property <string> active-chat-id: "";
    in-out property <string> active-chat-title: "";
    in-out property <string> active-chat-subtitle: "";
    in-out property <string> active-chat-avatar: "C";
    in-out property <bool> active-chat-has-avatar: false;
    in-out property <image> active-chat-avatar-image;
    in-out property <bool> active-chat-is-bot: false;
    in-out property <color> active-chat-bubble-color: #fb7185;

    // 5. Input Dock
    in-out property <string> draft-text: "";

    // 6. App Updates State
    in-out property <string> app-version: "v0.3.6";
    in-out property <string> update-status: "idle"; // "idle", "checking", "up-to-date", "available", "downloading"
    in-out property <string> latest-version-tag: "";

    // 7. Profile & Editor Modals
    in-out property <bool> show-bot-profile: false;
    in-out property <string> bot-profile-id: "";
    in-out property <string> bot-profile-name: "";
    in-out property <string> bot-profile-bio: "";
    in-out property <string> bot-profile-desc: "";
    in-out property <string> bot-profile-avatar-letter: "";
    in-out property <bool> bot-profile-has-avatar: false;
    in-out property <image> bot-profile-avatar-image;
    in-out property <color> bot-profile-bubble-color: Theme.accent-amber;
    in-out property <bool> bot-profile-is-owner: false;

    in-out property <bool> show-bot-editor: false;
    in-out property <bool> bot-editor-is-edit: false;
    in-out property <string> bot-editor-id: "";
    in-out property <string> bot-editor-name: "";
    in-out property <string> bot-editor-bio: "";
    in-out property <string> bot-editor-desc: "";
    in-out property <string> bot-editor-sys-prompt: "";
    in-out property <string> bot-editor-color-hex: "#F59E0B";
    in-out property <bool> bot-editor-has-pfp: false;
    in-out property <image> bot-editor-pfp-image;
    in-out property <string> bot-editor-pfp-url: "";
    in-out property <string> bot-editor-avatar-letter: "B";

    in-out property <bool> show-peer-profile: false;
    in-out property <string> peer-profile-id: "";
    in-out property <string> peer-profile-username: "";
    in-out property <string> peer-profile-subtitle: "";
    in-out property <string> peer-profile-avatar-letter: "";
    in-out property <bool> peer-profile-has-avatar: false;
    in-out property <image> peer-profile-avatar-image;
    in-out property <bool> peer-profile-is-online: false;

    // 8. Data Models
    in-out property <[ConversationItem]> conversations: [];
    in-out property <[MessageItem]> messages: [];
    in-out property <[BotCardItem]> bot_directory: [];
    in-out property <[PersonCardItem]> people_directory: [];

    // Callbacks
    callback tab-clicked(string);
    callback conversation-selected(string, string, string, string, bool, color);
    callback send-message(string);
    callback attach-image-clicked();
    callback accent-changed(string, color);
    callback search-query-changed(string);

    // Auth Callbacks
    callback google-login-requested();
    callback login-requested(string, string);
    callback signup-requested(string, string, string);
    callback logout-requested();

    // Discover Callbacks
    callback person-selected(string, string);

    // Profile & Bot Management Callbacks
    callback open-bot-profile(string);
    callback open-bot-editor(string, bool, string, string, string, string, string);
    callback pick-bot-avatar();
    callback save-bot(string, bool, string, string, string, string, string);
    callback delete-bot(string);
    callback bot-start-chat(string);
    callback open-peer-profile(string, string);
    callback peer-start-chat(string);
    callback header-profile-clicked();

    // Updates Callbacks
    callback check-updates-requested();
    callback perform-update-requested();

    public function scroll-to-bottom() {
        if (msg-flick.viewport-height > msg-flick.height) {
            msg-flick.viewport-y = msg-flick.height - msg-flick.viewport-height;
        } else {
            msg-flick.viewport-y = 0px;
        }
    }

    // ==========================================
    // VIEW 1: AUTH SCREEN (WHEN NOT LOGGED IN)
    // ==========================================
    if !root.is-logged-in : Rectangle {
        background: Theme.background;

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 420px;
                    border-radius: 28px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 36px;
                        spacing: 20px;
                        alignment: center;

                        // Logo & Brand Header
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/icons/bead.png");
                                    width: 64px;
                                    height: 64px;
                                }
                            }

                            Text {
                                text: "RtText";
                                color: Theme.text-primary;
                                font-size: 28px;
                                font-weight: 800;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "Chat with AI characters you create.";
                                color: Theme.text-subtle;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }

                        // Google Sign In Button (Front & Center)
                        TouchArea {
                            height: 52px;
                            enabled: !root.auth-busy;
                            clicked => { root.google-login-requested(); }

                            Rectangle {
                                border-radius: 26px;
                                background: root.auth-busy ? #252b36 : #ffffff;
                                border-width: 1px;
                                border-color: root.auth-busy ? #374151 : #e5e7eb;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 12px;

                                    if !root.auth-busy : Image {
                                        source: @image-url("../assets/icons/google.svg");
                                        width: 22px;
                                        height: 22px;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    Text {
                                        text: root.auth-busy ? "Waiting for Google sign in in browser..." : "Continue with Google";
                                        color: root.auth-busy ? #9ca3af : #1f2937;
                                        font-size: 15px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Error Banner
                        if root.auth-error != "" : Rectangle {
                            border-radius: 12px;
                            background: #2a1215;
                            border-width: 1px;
                            border-color: #ef4444;
                            HorizontalLayout {
                                padding: 10px;
                                Text {
                                    text: root.auth-error;
                                    color: #fca5a5;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Subtle Developer email login toggle
                        TouchArea {
                            height: 24px;
                            clicked => { root.show-email-auth = !root.show-email-auth; }
                            Text {
                                text: root.show-email-auth ? "Hide email sign in" : "Developer: Sign in with email instead";
                                color: Theme.text-subtle;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Expandable email/password section (only if toggled)
                        if root.show-email-auth : VerticalLayout {
                            spacing: 12px;

                            // Segmented Pill: Sign In | Create Account
                            Rectangle {
                                height: 34px;
                                border-radius: 17px;
                                background: Theme.surface;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding: 2px;
                                    spacing: 2px;

                                    TouchArea {
                                        horizontal-stretch: 1;
                                        clicked => { root.auth-mode = "login"; root.auth-error = ""; }
                                        Rectangle {
                                            border-radius: 15px;
                                            background: root.auth-mode == "login" ? #332610 : transparent;
                                            border-width: root.auth-mode == "login" ? 1px : 0px;
                                            border-color: root.user-accent-color;
                                            Text {
                                                text: "Sign In";
                                                color: root.auth-mode == "login" ? root.user-accent-color : Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        horizontal-stretch: 1;
                                        clicked => { root.auth-mode = "signup"; root.auth-error = ""; }
                                        Rectangle {
                                            border-radius: 15px;
                                            background: root.auth-mode == "signup" ? #332610 : transparent;
                                            border-width: root.auth-mode == "signup" ? 1px : 0px;
                                            border-color: root.user-accent-color;
                                            Text {
                                                text: "Create Account";
                                                color: root.auth-mode == "signup" ? root.user-accent-color : Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            if root.auth-mode == "signup" : Rectangle {
                                height: 40px;
                                border-radius: 20px;
                                background: Theme.surface-high;
                                border-width: 1px;
                                border-color: Theme.border;

                                if root.auth-username == "" : Text {
                                    x: 16px;
                                    text: "Username";
                                    color: Theme.text-subtle;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                TextInput {
                                    x: 16px;
                                    width: parent.width - 32px;
                                    height: 40px;
                                    text <=> root.auth-username;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 40px;
                                border-radius: 20px;
                                background: Theme.surface-high;
                                border-width: 1px;
                                border-color: Theme.border;

                                if root.auth-email == "" : Text {
                                    x: 16px;
                                    text: "Email address";
                                    color: Theme.text-subtle;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                TextInput {
                                    x: 16px;
                                    width: parent.width - 32px;
                                    height: 40px;
                                    text <=> root.auth-email;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 40px;
                                border-radius: 20px;
                                background: Theme.surface-high;
                                border-width: 1px;
                                border-color: Theme.border;

                                if root.auth-password == "" : Text {
                                    x: 16px;
                                    text: "Password";
                                    color: Theme.text-subtle;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                TextInput {
                                    x: 16px;
                                    width: parent.width - 32px;
                                    height: 40px;
                                    input-type: password;
                                    text <=> root.auth-password;
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                height: 42px;
                                clicked => {
                                    if !root.auth-busy && root.auth-email != "" && root.auth-password != "" {
                                        if root.auth-mode == "login" {
                                            root.login-requested(root.auth-email, root.auth-password);
                                        } else {
                                            root.signup-requested(root.auth-email, root.auth-password, root.auth-username);
                                        }
                                    }
                                }

                                Rectangle {
                                    border-radius: 21px;
                                    background: root.auth-busy ? #333333 : root.user-accent-color;

                                    Text {
                                        text: root.auth-busy ? "Connecting..." : (root.auth-mode == "login" ? "Sign In" : "Create Account");
                                        color: root.auth-busy ? #aaaaaa : #0b0f14;
                                        font-size: 13px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // VIEW 2: MAIN 2-PANE APPLICATION
    // ==========================================
    if root.is-logged-in : HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // ==========================================
        // LEFT PANE (SIDEBAR: 360px)
        // ==========================================
        Rectangle {
            width: 360px;
            background: Theme.background;

            // Border right
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Theme.border;
            }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // 1. TOP HEADER: RtText + App Logo
                Rectangle {
                    height: 60px;
                    background: Theme.background;

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            Image {
                                source: @image-url("../assets/icons/bead.png");
                                width: 28px;
                                height: 28px;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: "RtText";
                                color: Theme.text-primary;
                                font-size: 20px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        // Bead balance badge in header
                        Rectangle {
                            height: 30px;
                            border-radius: 15px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/bead.png");
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "\{root.bead-balance}";
                                    color: root.user-accent-color;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // 2. SEGMENTED NAVIGATION PILL (Chats | Discover | Profile)
                Rectangle {
                    height: 52px;
                    background: Theme.background;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 8px;

                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;

                                // TAB 1: CHATS
                                TouchArea {
                                    horizontal-stretch: 1;
                                    clicked => { root.active-nav = "chats"; root.tab-clicked("chats"); }
                                    Rectangle {
                                        border-radius: 17px;
                                        background: root.active-nav == "chats" ? #332610 : (parent.has-hover ? #1a222e : transparent);
                                        border-width: root.active-nav == "chats" ? 1px : 0px;
                                        border-color: root.user-accent-color;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;

                                            Image {
                                                source: @image-url("../assets/icons/chat_bubble.svg");
                                                colorize: root.active-nav == "chats" ? root.user-accent-color : Theme.text-subtle;
                                                width: 15px;
                                                height: 15px;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Text {
                                                text: "Chats";
                                                color: root.active-nav == "chats" ? root.user-accent-color : Theme.text-secondary;
                                                font-size: 13px;
                                                font-weight: root.active-nav == "chats" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // TAB 2: DISCOVER
                                TouchArea {
                                    horizontal-stretch: 1;
                                    clicked => { root.active-nav = "discover"; root.tab-clicked("discover"); }
                                    Rectangle {
                                        border-radius: 17px;
                                        background: root.active-nav == "discover" ? #332610 : (parent.has-hover ? #1a222e : transparent);
                                        border-width: root.active-nav == "discover" ? 1px : 0px;
                                        border-color: root.user-accent-color;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;

                                            Image {
                                                source: @image-url("../assets/icons/explore.svg");
                                                colorize: root.active-nav == "discover" ? root.user-accent-color : Theme.text-subtle;
                                                width: 15px;
                                                height: 15px;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Text {
                                                text: "Discover";
                                                color: root.active-nav == "discover" ? root.user-accent-color : Theme.text-secondary;
                                                font-size: 13px;
                                                font-weight: root.active-nav == "discover" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // TAB 3: PROFILE
                                TouchArea {
                                    horizontal-stretch: 1;
                                    clicked => { root.active-nav = "profile"; root.tab-clicked("profile"); }
                                    Rectangle {
                                        border-radius: 17px;
                                        background: root.active-nav == "profile" ? #332610 : (parent.has-hover ? #1a222e : transparent);
                                        border-width: root.active-nav == "profile" ? 1px : 0px;
                                        border-color: root.user-accent-color;

                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;

                                            Image {
                                                source: @image-url("../assets/icons/person.svg");
                                                colorize: root.active-nav == "profile" ? root.user-accent-color : Theme.text-subtle;
                                                width: 15px;
                                                height: 15px;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Text {
                                                text: "Profile";
                                                color: root.active-nav == "profile" ? root.user-accent-color : Theme.text-secondary;
                                                font-size: 13px;
                                                font-weight: root.active-nav == "profile" ? 700 : 500;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // DIVIDER
                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                // ==========================================
                // SIDEBAR CONTENT: 1. CHATS LIST
                // ==========================================
                if root.active-nav == "chats" : Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: 0px;

                        for conv in root.conversations : touch-item := TouchArea {
                            height: 72px;
                            clicked => {
                                root.active-chat-id = conv.id;
                                root.active-chat-title = conv.title;
                                root.active-chat-subtitle = conv.subtitle;
                                root.active-chat-avatar = conv.avatar-letter;
                                root.active-chat-has-avatar = conv.has-avatar;
                                root.active-chat-avatar-image = conv.avatar-image;
                                root.active-chat-is-bot = conv.is-bot;
                                root.active-chat-bubble-color = conv.bubble-color;
                                root.conversation-selected(
                                    conv.id,
                                    conv.title,
                                    conv.subtitle,
                                    conv.avatar-letter,
                                    conv.is-bot,
                                    conv.bubble-color
                                );
                            }

                            Rectangle {
                                background: root.active-chat-id == conv.id ? #19202a : (touch-item.has-hover ? #131922 : transparent);

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 12px;

                                    // Avatar: Real Image or Colored Initial
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 48px;
                                            height: 48px;
                                            border-radius: 24px;
                                            background: Theme.surface-high;
                                            border-width: conv.is-bot ? 1.5px : 0px;
                                            border-color: conv.bubble-color;
                                            clip: true;

                                            if conv.has-avatar : Image {
                                                source: conv.avatar-image;
                                                width: 48px;
                                                height: 48px;
                                                image-fit: cover;
                                            }

                                            if !conv.has-avatar : Text {
                                                text: conv.avatar-letter;
                                                color: conv.is-bot ? conv.bubble-color : Theme.text-primary;
                                                font-size: 18px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            // Online Badge
                                            if conv.is-online : Rectangle {
                                                x: parent.width - 12px;
                                                y: parent.height - 12px;
                                                width: 10px;
                                                height: 10px;
                                                border-radius: 5px;
                                                background: #22c55e;
                                                border-width: 1.5px;
                                                border-color: Theme.background;
                                            }
                                        }
                                    }

                                    // Conversation Details
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: conv.title;
                                                horizontal-stretch: 1;
                                                color: Theme.text-primary;
                                                font-size: 14px;
                                                font-weight: 600;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: conv.timestamp;
                                                color: Theme.text-subtle;
                                                font-size: 11px;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: conv.last-message;
                                                horizontal-stretch: 1;
                                                color: Theme.text-secondary;
                                                font-size: 12px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: ">";
                                                color: Theme.text-subtle;
                                                font-size: 11px;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Hairline bottom divider
                                Rectangle {
                                    x: 74px;
                                    width: parent.width - 74px;
                                    y: 71px;
                                    height: 1px;
                                    background: Theme.border-subtle;
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // SIDEBAR CONTENT: 2. DISCOVER TAB
                // ==========================================
                if root.active-nav == "discover" : Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;
                        alignment: start;

                        // Segmented Subnav Pill: Characters | People
                        Rectangle {
                            height: 38px;
                            border-radius: Theme.radius-pill;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;

                                TouchArea {
                                    horizontal-stretch: 1;
                                    clicked => { root.discover-subnav = "characters"; }
                                    Rectangle {
                                        border-radius: Theme.radius-pill;
                                        background: root.discover-subnav == "characters" ? #3d2c10 : transparent;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/icons/sparkle.svg");
                                                width: 14px;
                                                height: 14px;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: "Characters";
                                                color: root.discover-subnav == "characters" ? root.user-accent-color : Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                TouchArea {
                                    horizontal-stretch: 1;
                                    clicked => { root.discover-subnav = "people"; }
                                    Rectangle {
                                        border-radius: Theme.radius-pill;
                                        background: root.discover-subnav == "people" ? #3d2c10 : transparent;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/icons/person.svg");
                                                colorize: root.discover-subnav == "people" ? root.user-accent-color : Theme.text-secondary;
                                                width: 14px;
                                                height: 14px;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: "People";
                                                color: root.discover-subnav == "people" ? root.user-accent-color : Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Interactive Search Box
                        Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-pill;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 10px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/search.svg");
                                    colorize: Theme.text-subtle;
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - self.height) / 2;
                                }

                                if root.search-query == "" : Text {
                                    text: root.discover-subnav == "characters" ? "Search characters..." : "Search people...";
                                    color: Theme.text-subtle;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }

                                TextInput {
                                    text <=> root.search-query;
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    edited => { root.search-query-changed(self.text); }
                                }
                            }
                        }

                        // CHARACTERS SUBNAV LIST
                        if root.discover-subnav == "characters" : VerticalLayout {
                            spacing: 10px;

                            // + Create Character Button
                            touch-create-bot := TouchArea {
                                height: 42px;
                                clicked => {
                                    root.open-bot-editor("", false, "", "", "", "", "#F59E0B");
                                }
                                Rectangle {
                                    border-radius: Theme.radius-pill;
                                    background: touch-create-bot.has-hover ? #2e2616 : #231c0e;
                                    border-width: 1px;
                                    border-color: root.user-accent-color;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        Text {
                                            text: "+ Create Character";
                                            color: root.user-accent-color;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            for bot in root.bot_directory : touch-bot := TouchArea {
                                height: 80px;
                                clicked => {
                                    root.open-bot-profile(bot.id);
                                }

                                Rectangle {
                                    border-radius: Theme.radius-lg;
                                    background: touch-bot.has-hover ? #19202a : Theme.card;
                                    border-width: 1px;
                                    border-color: Theme.border;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 12px;

                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 48px;
                                                height: 48px;
                                                border-radius: 24px;
                                                background: Theme.surface-high;
                                                border-width: 1.5px;
                                                border-color: bot.bubble-color;
                                                clip: true;

                                                if bot.has-avatar : Image {
                                                    source: bot.avatar-image;
                                                    width: 48px;
                                                    height: 48px;
                                                    image-fit: cover;
                                                }

                                                if !bot.has-avatar : Text {
                                                    text: bot.avatar-letter;
                                                    color: bot.bubble-color;
                                                    font-size: 18px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 3px;
                                            Text {
                                                text: bot.name;
                                                color: Theme.text-primary;
                                                font-size: 14px;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: bot.bio;
                                                color: Theme.text-secondary;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // PEOPLE SUBNAV LIST (Hidden by default; only shown when searched)
                        if root.discover-subnav == "people" : VerticalLayout {
                            spacing: 10px;

                            if root.search-query == "" : VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                padding-top: 48px;
                                padding-bottom: 48px;

                                Image {
                                    source: @image-url("../assets/icons/person.svg");
                                    colorize: Theme.text-subtle;
                                    width: 44px;
                                    height: 44px;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Search People";
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Type a username in the search bar above to find people.";
                                    color: Theme.text-subtle;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.search-query != "" && root.people_directory.length == 0 : VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                padding-top: 48px;
                                padding-bottom: 48px;

                                Text {
                                    text: "No people found matching \"" + root.search-query + "\"";
                                    color: Theme.text-subtle;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.search-query != "" && root.people_directory.length > 0 : VerticalLayout {
                                spacing: 10px;

                                for person in root.people_directory : touch-person := TouchArea {
                                    height: 76px;
                                    clicked => {
                                        root.open-peer-profile(person.id, person.username);
                                    }

                                    Rectangle {
                                        border-radius: Theme.radius-lg;
                                        background: touch-person.has-hover ? #19202a : Theme.card;
                                        border-width: 1px;
                                        border-color: Theme.border;

                                        HorizontalLayout {
                                            padding: 12px;
                                            spacing: 12px;

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 48px;
                                                    height: 48px;
                                                    border-radius: 24px;
                                                    background: Theme.surface-high;
                                                    clip: true;

                                                    if person.has-avatar : Image {
                                                        source: person.avatar-image;
                                                        width: 48px;
                                                        height: 48px;
                                                        image-fit: cover;
                                                    }

                                                    if !person.has-avatar : Text {
                                                        text: person.avatar-letter;
                                                        color: Theme.text-primary;
                                                        font-size: 18px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 3px;
                                                Text {
                                                    text: "@" + person.username;
                                                    color: Theme.text-primary;
                                                    font-size: 14px;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: person.subtitle;
                                                    color: Theme.text-secondary;
                                                    font-size: 12px;
                                                    overflow: elide;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 72px;
                                                    height: 30px;
                                                    border-radius: 15px;
                                                    background: Theme.surface-high;
                                                    border-width: 1px;
                                                    border-color: root.user-accent-color;
                                                    Text {
                                                        text: "Chat";
                                                        color: root.user-accent-color;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // SIDEBAR CONTENT: 3. PROFILE TAB
                // ==========================================
                if root.active-nav == "profile" : Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;
                        alignment: start;

                        // Profile Header with Avatar & Username
                        Rectangle {
                            height: 104px;
                            border-radius: Theme.radius-lg;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding: 16px;
                                spacing: 14px;
                                alignment: center;

                                Rectangle {
                                    width: 56px;
                                    height: 56px;
                                    border-radius: 28px;
                                    background: Theme.surface-high;
                                    border-width: 2px;
                                    border-color: root.user-accent-color;
                                    clip: true;

                                    if root.user-has-avatar : Image {
                                        source: root.user-avatar-image;
                                        width: 56px;
                                        height: 56px;
                                        image-fit: cover;
                                    }

                                    if !root.user-has-avatar : Text {
                                        text: "U";
                                        color: root.user-accent-color;
                                        font-size: 22px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: root.current-username;
                                        color: Theme.text-primary;
                                        font-size: 16px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "@" + root.current-username;
                                        color: Theme.text-subtle;
                                        font-size: 12px;
                                    }
                                    Text {
                                        text: "Authenticated via GoTrue";
                                        color: Theme.text-subtle;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }

                        // BEAD BALANCE CARD
                        Rectangle {
                            height: 72px;
                            border-radius: Theme.radius-lg;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                alignment: center;
                                spacing: 14px;

                                Image {
                                    source: @image-url("../assets/icons/bead.png");
                                    width: 38px;
                                    height: 38px;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "\{root.bead-balance}";
                                    color: root.user-accent-color;
                                    font-size: 26px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "Bead Balance";
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Used for AI character replies";
                                        color: Theme.text-subtle;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }

                        // APPEARANCE ACCENT SELECTOR
                        Rectangle {
                            height: 84px;
                            border-radius: Theme.radius-lg;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                Text {
                                    text: "Appearance Accent Color";
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                }

                                HorizontalLayout {
                                    alignment: space-around;

                                    // Swatch 1: Teal
                                    TouchArea {
                                        width: 28px; height: 28px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-teal;
                                            root.user-accent-id = "teal";
                                            root.accent-changed("teal", Theme.accent-teal);
                                        }
                                        Rectangle {
                                            border-radius: 14px;
                                            background: Theme.accent-teal;
                                            if root.user-accent-id == "teal" : Text { text: "✓"; color: #0b0f14; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }

                                    // Swatch 2: Violet
                                    TouchArea {
                                        width: 28px; height: 28px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-violet;
                                            root.user-accent-id = "violet";
                                            root.accent-changed("violet", Theme.accent-violet);
                                        }
                                        Rectangle {
                                            border-radius: 14px;
                                            background: Theme.accent-violet;
                                            if root.user-accent-id == "violet" : Text { text: "✓"; color: #0b0f14; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }

                                    // Swatch 3: Rose
                                    TouchArea {
                                        width: 28px; height: 28px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-rose;
                                            root.user-accent-id = "rose";
                                            root.accent-changed("rose", Theme.accent-rose);
                                        }
                                        Rectangle {
                                            border-radius: 14px;
                                            background: Theme.accent-rose;
                                            if root.user-accent-id == "rose" : Text { text: "✓"; color: #0b0f14; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }

                                    // Swatch 4: Amber (Default)
                                    TouchArea {
                                        width: 28px; height: 28px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-amber;
                                            root.user-accent-id = "amber";
                                            root.accent-changed("amber", Theme.accent-amber);
                                        }
                                        Rectangle {
                                            border-radius: 14px;
                                            background: Theme.accent-amber;
                                            if root.user-accent-id == "amber" : Text { text: "✓"; color: #0b0f14; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }

                                    // Swatch 5: Blue
                                    TouchArea {
                                        width: 28px; height: 28px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-blue;
                                            root.user-accent-id = "blue";
                                            root.accent-changed("blue", Theme.accent-blue);
                                        }
                                        Rectangle {
                                            border-radius: 14px;
                                            background: Theme.accent-blue;
                                            if root.user-accent-id == "blue" : Text { text: "✓"; color: #0b0f14; font-size: 14px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        // IN-APP UPDATE CHECKER & UPDATER
                        Rectangle {
                            height: 80px;
                            border-radius: Theme.radius-lg;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "App Updates";
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.update-status == "up-to-date" ? "You're up to date (" + root.app-version + ")" :
                                              (root.update-status == "available" ? "New update: " + root.latest-version-tag :
                                              (root.update-status == "checking" ? "Checking GitHub..." : "Desktop " + root.app-version));
                                        color: root.update-status == "available" ? #22c55e : Theme.text-subtle;
                                        font-size: 11px;
                                    }
                                }

                                TouchArea {
                                    width: 100px;
                                    height: 34px;
                                    clicked => {
                                        if root.update-status == "available" {
                                            root.perform-update-requested();
                                        } else {
                                            root.check-updates-requested();
                                        }
                                    }

                                    Rectangle {
                                        border-radius: 17px;
                                        background: root.update-status == "available" ? root.user-accent-color : Theme.surface-high;
                                        border-width: 1px;
                                        border-color: root.user-accent-color;

                                        Text {
                                            text: root.update-status == "available" ? "Update Now" :
                                                  (root.update-status == "checking" ? "Checking..." : "Check");
                                            color: root.update-status == "available" ? #0b0f14 : root.user-accent-color;
                                            font-size: 12px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // LOG OUT BUTTON
                        TouchArea {
                            height: 48px;
                            clicked => { root.logout-requested(); }

                            Rectangle {
                                border-radius: Theme.radius-lg;
                                background: #221215;
                                border-width: 1px;
                                border-color: #ef444455;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;

                                    Text {
                                        text: "Log Out of RtText";
                                        color: #ef4444;
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // RIGHT PANE (ACTIVE CHAT)
        // ==========================================
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.background;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // 1. CHAT HEADER
                Rectangle {
                    height: 60px;
                    background: Theme.surface;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        alignment: space-between;

                        touch-hdr := TouchArea {
                            clicked => { root.header-profile-clicked(); }

                            HorizontalLayout {
                                spacing: 14px;
                                alignment: start;

                                // Avatar (Image or Initial)
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 20px;
                                    background: Theme.surface-high;
                                    border-width: root.active-chat-is-bot ? 1.5px : 0px;
                                    border-color: root.active-chat-bubble-color;
                                    clip: true;
                                    y: (parent.height - self.height) / 2;

                                    if root.active-chat-has-avatar : Image {
                                        source: root.active-chat-avatar-image;
                                        width: 40px;
                                        height: 40px;
                                        image-fit: cover;
                                    }

                                    if !root.active-chat-has-avatar : Text {
                                        text: root.active-chat-avatar;
                                        color: root.active-chat-is-bot ? root.active-chat-bubble-color : Theme.text-primary;
                                        font-size: 16px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: root.active-chat-title;
                                        color: Theme.text-primary;
                                        font-size: 15px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: root.active-chat-subtitle;
                                        color: Theme.text-secondary;
                                        font-size: 12px;
                                    }
                                }
                            }
                        }

                        // Right action dot
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 34px;
                                height: 34px;
                                border-radius: 17px;
                                background: Theme.surface-high;
                                Text {
                                    text: "⋮";
                                    color: Theme.text-primary;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // 2. MESSAGES STREAM
                msg-flick := Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 18px;
                        padding-bottom: 24px;
                        spacing: 12px;

                        for msg in root.messages : HorizontalLayout {
                            alignment: msg.is-separator ? center : (msg.is-me ? end : start);

                            if msg.is-separator : Rectangle {
                                border-radius: 12px;
                                background: #18202d;
                                border-width: 1px;
                                border-color: #2b384c;
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 5px;
                                    padding-bottom: 5px;
                                    Text {
                                        text: msg.separator-text;
                                        color: #94a3b8;
                                        font-size: 11px;
                                        font-weight: 600;
                                    }
                                }
                            }

                            if !msg.is-separator : Rectangle {
                                border-radius: 16px;
                                background: msg.bubble_color;
                                max-width: 560px;

                                VerticalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    padding-top: 10px;
                                    padding-bottom: 8px;
                                    spacing: 6px;

                                    // Sender Name (in group chat)
                                    if msg.show-sender : Text {
                                        text: msg.sender-name;
                                        color: #818cf8;
                                        font-size: 11.5px;
                                        font-weight: 700;
                                    }

                                    // Attached Media Image (1:1 with mobile: 280x190 cover thumbnail)
                                    if msg.has-media : Rectangle {
                                        width: 280px;
                                        height: 190px;
                                        border-radius: 12px;
                                        clip: true;
                                        background: #00000033;
                                        Image {
                                            source: msg.media-image;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: cover;
                                        }
                                    }

                                    // Message Text
                                    if msg.content != "" : Text {
                                        text: msg.content;
                                        color: msg.is-me ? #0b0f14 : Theme.text-primary;
                                        font-size: 13.5px;
                                        wrap: word-wrap;
                                    }

                                    // Timestamp & Status (Single check vs Double blue check)
                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 4px;
                                        Text {
                                            text: msg.timestamp;
                                            color: msg.is-me ? #0b0f14aa : #ffffffaa;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }

                                        if msg.is-me : Image {
                                            source: msg.is-read ? @image-url("../assets/icons/checkmarks.svg") : @image-url("../assets/icons/single_check.svg");
                                            width: msg.is-read ? 14px : 11px;
                                            height: 9px;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }

                        // Bottom Spacer so the last message is never cut off
                        Rectangle {
                            height: 16px;
                        }
                    }
                }

                // 3. BOTTOM INPUT DOCK (Photo Attach + Message Input + Send)
                Rectangle {
                    height: 68px;
                    background: Theme.surface;

                    Rectangle {
                        y: 0px;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;

                        // 1. Image attachment button
                        VerticalLayout {
                            alignment: center;

                            TouchArea {
                                width: 40px;
                                height: 40px;
                                clicked => { root.attach-image-clicked(); }

                                Rectangle {
                                    border-radius: 20px;
                                    background: parent.has-hover ? Theme.surface-high : transparent;
                                    Image {
                                        source: @image-url("../assets/icons/image_attach.svg");
                                        colorize: Theme.text-secondary;
                                        width: 22px;
                                        height: 22px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }

                        // 2. Message Input Field
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;

                            Rectangle {
                                height: 44px;
                                border-radius: 22px;
                                background: Theme.surface-high;
                                border-width: 1px;
                                border-color: Theme.border;

                                if root.draft-text == "" : Text {
                                    x: 18px;
                                    text: "Message...";
                                    color: Theme.text-subtle;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }

                                TextInput {
                                    x: 18px;
                                    width: parent.width - 36px;
                                    height: 44px;
                                    text <=> root.draft-text;
                                    color: Theme.text-primary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    accepted => {
                                        if (root.draft-text != "") {
                                            root.send-message(root.draft-text);
                                            root.draft-text = "";
                                        }
                                    }
                                }
                            }
                        }

                        // 3. Send button
                        VerticalLayout {
                            alignment: center;

                            TouchArea {
                                width: 44px;
                                height: 44px;
                                clicked => {
                                    if (root.draft-text != "") {
                                        root.send-message(root.draft-text);
                                        root.draft-text = "";
                                    }
                                }

                                Rectangle {
                                    border-radius: 22px;
                                    background: root.draft-text != "" ? root.user-accent-color : #1e2633;

                                    Image {
                                        source: @image-url("../assets/icons/send.svg");
                                        colorize: root.draft-text != "" ? #0b0f14 : Theme.text-subtle;
                                        width: 18px;
                                        height: 18px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // MODAL OVERLAY 1: BOT PROFILE
    // ==========================================
    if root.show-bot-profile : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000aa;

        // Backdrop click to dismiss
        TouchArea {
            clicked => { root.show-bot-profile = false; }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 440px;
                    border-radius: 24px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 16px;

                        // Header with close button
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Character Profile";
                                color: Theme.text-secondary;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                width: 32px;
                                height: 32px;
                                clicked => { root.show-bot-profile = false; }
                                Rectangle {
                                    border-radius: 16px;
                                    background: parent.has-hover ? Theme.surface-high : transparent;
                                    Text {
                                        text: "✕";
                                        color: Theme.text-secondary;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Avatar & Name Card
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;

                            Rectangle {
                                width: 72px;
                                height: 72px;
                                border-radius: 36px;
                                background: Theme.surface-high;
                                border-width: 2px;
                                border-color: root.bot-profile-bubble-color;
                                clip: true;

                                if root.bot-profile-has-avatar : Image {
                                    source: root.bot-profile-avatar-image;
                                    width: 72px;
                                    height: 72px;
                                    image-fit: cover;
                                }

                                if !root.bot-profile-has-avatar : Text {
                                    text: root.bot-profile-avatar-letter;
                                    color: root.bot-profile-bubble-color;
                                    font-size: 28px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: root.bot-profile-name;
                                color: Theme.text-primary;
                                font-size: 20px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }

                            if root.bot-profile-bio != "" : Text {
                                text: root.bot-profile-bio;
                                color: root.bot-profile-bubble-color;
                                font-size: 13px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        // Description
                        if root.bot-profile-desc != "" : Rectangle {
                            border-radius: 14px;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding: 14px;
                                Text {
                                    text: root.bot-profile-desc;
                                    color: Theme.text-secondary;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Primary Action: Start / Continue Chat
                        TouchArea {
                            height: 44px;
                            clicked => {
                                root.show-bot-profile = false;
                                root.bot-start-chat(root.bot-profile-id);
                            }
                            Rectangle {
                                border-radius: 22px;
                                background: root.user-accent-color;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "Start Chat";
                                        color: #0b0f14;
                                        font-size: 14px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Owner Actions: Edit & Delete
                        if root.bot-profile-is-owner : HorizontalLayout {
                            spacing: 10px;

                            TouchArea {
                                horizontal-stretch: 1;
                                height: 38px;
                                clicked => {
                                    root.show-bot-profile = false;
                                    root.open-bot-editor(
                                        root.bot-profile-id,
                                        true,
                                        root.bot-profile-name,
                                        root.bot-profile-bio,
                                        root.bot-profile-desc,
                                        "",
                                        "#F59E0B"
                                    );
                                }
                                Rectangle {
                                    border-radius: 19px;
                                    background: Theme.surface-high;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Edit Character";
                                            color: Theme.text-primary;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            TouchArea {
                                horizontal-stretch: 1;
                                height: 38px;
                                clicked => {
                                    root.delete-bot(root.bot-profile-id);
                                    root.show-bot-profile = false;
                                }
                                Rectangle {
                                    border-radius: 19px;
                                    background: #2b1114;
                                    border-width: 1px;
                                    border-color: #ef444455;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Delete Character";
                                            color: #ef4444;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // MODAL OVERLAY 2: BOT CREATOR / EDITOR
    // ==========================================
    if root.show-bot-editor : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000bb;

        TouchArea {
            clicked => { root.show-bot-editor = false; }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 520px;
                    max-height: root.height * 0.90;
                    border-radius: 24px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        // 1. Header (Fixed)
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.bot-editor-is-edit ? "Edit Character" : "Create Character";
                                color: Theme.text-primary;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                width: 32px;
                                height: 32px;
                                clicked => { root.show-bot-editor = false; }
                                Rectangle {
                                    border-radius: 16px;
                                    background: parent.has-hover ? Theme.surface-high : transparent;
                                    Text {
                                        text: "✕";
                                        color: Theme.text-secondary;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // 2. Scrollable Body
                        bot-editor-flick := Flickable {
                            vertical-stretch: 1;

                            VerticalLayout {
                                spacing: 14px;
                                padding-right: 4px;

                                // Avatar Picker Circle
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;

                                    HorizontalLayout {
                                        alignment: center;

                                        TouchArea {
                                            width: 76px;
                                            height: 76px;
                                            clicked => { root.pick-bot-avatar(); }

                                            Rectangle {
                                                width: 76px;
                                                height: 76px;
                                                border-radius: 38px;
                                                background: Theme.surface-high;
                                                clip: true;
                                                border-width: 2px;
                                                border-color: parent.has-hover ? root.user-accent-color : Theme.border;

                                                if root.bot-editor-has-pfp : Image {
                                                    source: root.bot-editor-pfp-image;
                                                    width: 76px;
                                                    height: 76px;
                                                    image-fit: cover;
                                                }

                                                if !root.bot-editor-has-pfp : Text {
                                                    text: root.bot-editor-avatar-letter;
                                                    color: Theme.text-primary;
                                                    font-size: 26px;
                                                    font-weight: 800;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }

                                                // Camera Badge Overlay
                                                Rectangle {
                                                    x: 48px;
                                                    y: 48px;
                                                    width: 24px;
                                                    height: 24px;
                                                    border-radius: 12px;
                                                    background: root.user-accent-color;
                                                    HorizontalLayout {
                                                        alignment: center;
                                                        Text {
                                                            text: "📷";
                                                            font-size: 11px;
                                                            vertical-alignment: center;
                                                            horizontal-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Click to upload avatar";
                                        color: Theme.text-subtle;
                                        font-size: 11px;
                                        horizontal-alignment: center;
                                    }
                                }

                                // Form field: Name
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Name *"; color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                                    Rectangle {
                                        height: 40px;
                                        border-radius: 10px;
                                        background: Theme.surface-high;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        TextInput {
                                            x: 12px;
                                            width: parent.width - 24px;
                                            text <=> root.bot-editor-name;
                                            color: Theme.text-primary;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Form field: Tagline / Bio
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Tagline / Short Bio"; color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                                    Rectangle {
                                        height: 40px;
                                        border-radius: 10px;
                                        background: Theme.surface-high;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        TextInput {
                                            x: 12px;
                                            width: parent.width - 24px;
                                            text <=> root.bot-editor-bio;
                                            color: Theme.text-primary;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Form field: Description
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "Description (Personality / Background)"; color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                                    Rectangle {
                                        height: 72px;
                                        border-radius: 10px;
                                        background: Theme.surface-high;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        TextInput {
                                            x: 12px;
                                            y: 8px;
                                            width: parent.width - 24px;
                                            height: parent.height - 16px;
                                            single-line: false;
                                            wrap: word-wrap;
                                            text <=> root.bot-editor-desc;
                                            color: Theme.text-primary;
                                            font-size: 13px;
                                        }
                                    }
                                }

                                // Form field: System Prompt
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "System Prompt (AI Persona Instructions) *"; color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                                    Rectangle {
                                        height: 120px;
                                        border-radius: 10px;
                                        background: Theme.surface-high;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        TextInput {
                                            x: 12px;
                                            y: 8px;
                                            width: parent.width - 24px;
                                            height: parent.height - 16px;
                                            single-line: false;
                                            wrap: word-wrap;
                                            text <=> root.bot-editor-sys-prompt;
                                            color: Theme.text-primary;
                                            font-size: 13px;
                                        }
                                    }
                                }
                            }
                        }

                        // 3. Footer (Fixed)
                        HorizontalLayout {
                            spacing: 12px;
                            padding-top: 4px;

                            TouchArea {
                                horizontal-stretch: 1;
                                height: 40px;
                                clicked => { root.show-bot-editor = false; }
                                Rectangle {
                                    border-radius: 20px;
                                    background: Theme.surface-high;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: "Cancel";
                                            color: Theme.text-secondary;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            TouchArea {
                                horizontal-stretch: 1;
                                height: 40px;
                                clicked => {
                                    if (root.bot-editor-name != "") {
                                        root.save-bot(
                                            root.bot-editor-id,
                                            root.bot-editor-is-edit,
                                            root.bot-editor-name,
                                            root.bot-editor-bio,
                                            root.bot-editor-desc,
                                            root.bot-editor-sys-prompt,
                                            root.bot-editor-color-hex
                                        );
                                        root.show-bot-editor = false;
                                    }
                                }
                                Rectangle {
                                    border-radius: 20px;
                                    background: root.bot-editor-name != "" ? root.user-accent-color : #1e2633;
                                    HorizontalLayout {
                                        alignment: center;
                                        Text {
                                            text: root.bot-editor-is-edit ? "Save Changes" : "Create Character";
                                            color: root.bot-editor-name != "" ? #0b0f14 : Theme.text-subtle;
                                            font-size: 13px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // MODAL OVERLAY 3: PEER (USER) PROFILE
    // ==========================================
    if root.show-peer-profile : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {
            clicked => { root.show-peer-profile = false; }
        }

        VerticalLayout {
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 420px;
                    border-radius: 24px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 24px;
                        spacing: 18px;

                        // Header with close
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "User Profile";
                                color: Theme.text-secondary;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                width: 32px;
                                height: 32px;
                                clicked => { root.show-peer-profile = false; }
                                Rectangle {
                                    border-radius: 16px;
                                    background: parent.has-hover ? Theme.surface-high : transparent;
                                    Text {
                                        text: "✕";
                                        color: Theme.text-secondary;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Avatar & Info
                        VerticalLayout {
                            alignment: center;
                            spacing: 12px;

                            Rectangle {
                                width: 72px;
                                height: 72px;
                                border-radius: 36px;
                                background: Theme.surface-high;
                                border-width: 2px;
                                border-color: Theme.border;
                                clip: true;

                                if root.peer-profile-has-avatar : Image {
                                    source: root.peer-profile-avatar-image;
                                    width: 72px;
                                    height: 72px;
                                    image-fit: cover;
                                }

                                if !root.peer-profile-has-avatar : Text {
                                    text: root.peer-profile-avatar-letter;
                                    color: Theme.text-primary;
                                    font-size: 28px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "@" + root.peer-profile-username;
                                color: Theme.text-primary;
                                font-size: 20px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.peer-profile-subtitle;
                                color: Theme.text-secondary;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }

                        // Send Direct Message Button
                        TouchArea {
                            height: 44px;
                            clicked => {
                                root.show-peer-profile = false;
                                root.peer-start-chat(root.peer-profile-id);
                            }
                            Rectangle {
                                border-radius: 22px;
                                background: root.user-accent-color;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text {
                                        text: "Send Message";
                                        color: #0b0f14;
                                        font-size: 14px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
