import { Theme } from "theme.slint";

export struct ConversationItem {
    id: string,
    title: string,
    subtitle: string,
    avatar_letter: string,
    last_message: string,
    timestamp: string,
    is_bot: bool,
    is_online: bool,
    bubble_color: color,
}

export struct MessageItem {
    id: string,
    content: string,
    timestamp: string,
    is_me: bool,
    bubble_color: color,
}

export struct BotCardItem {
    id: string,
    name: string,
    bio: string,
    avatar_letter: string,
    bubble_color: color,
}

export component MainWindow inherits Window {
    title: "RtText";
    width: 1040px;
    height: 680px;
    background: Theme.background;
    default-font-size: 13px;

    in-out property <string> active-nav: "chats"; // "chats", "discover", "profile"
    in-out property <string> discover-subnav: "characters"; // "characters", "people"

    // User's customizable appearance accent (Default Amber #FBBF24 matching screenshot 3)
    in-out property <color> user-accent-color: Theme.accent-amber;
    in-out property <string> user-accent-id: "amber";

    in-out property <string> active-chat-id: "nobara";
    in-out property <string> active-chat-title: "Nobara Kugisaki";
    in-out property <string> active-chat-subtitle: "Student at tokyo high";
    in-out property <string> active-chat-avatar: "N";
    in-out property <bool> active-chat-is-bot: true;
    in-out property <color> active-chat-bubble-color: #fb7185;

    in-out property <string> draft-text: "";
    in-out property <string> current-username: "LDaccoutn";
    in-out property <int> bead-balance: 139;

    in-out property <[ConversationItem]> conversations: [
        {
            id: "nobara",
            title: "Nobara Kugisaki",
            subtitle: "Student at tokyo high",
            avatar_letter: "N",
            last_message: "Obviously it does. I don't need you...",
            timestamp: "14:16",
            is_bot: true,
            is_online: false,
            bubble_color: #fb7185,
        },
        {
            id: "anika",
            title: "anikaitanikait10",
            subtitle: "last active today at 1:34 PM",
            avatar_letter: "A",
            last_message: "deal",
            timestamp: "9:32 AM",
            is_bot: false,
            is_online: false,
            bubble_color: Theme.dm-bubble,
        },
        {
            id: "sorcerors",
            title: "Sorcerors",
            subtitle: "5 members • 1 bot",
            avatar_letter: "S",
            last_message: "Yo! What's up? Did someone su...",
            timestamp: "14:33",
            is_bot: false,
            is_online: false,
            bubble_color: Theme.dm-bubble,
        },
        {
            id: "suhaibawan",
            title: "suhaibawan000",
            subtitle: "Online",
            avatar_letter: "S",
            last_message: "You: hi",
            timestamp: "14:17",
            is_bot: false,
            is_online: true,
            bubble_color: Theme.dm-bubble,
        },
        {
            id: "bilquees",
            title: "Bilquees",
            subtitle: "Last active 13:29",
            avatar_letter: "B",
            last_message: "You: Hello",
            timestamp: "13:29",
            is_bot: false,
            is_online: false,
            bubble_color: Theme.dm-bubble,
        },
        {
            id: "uabid",
            title: "uabidM",
            subtitle: "Online",
            avatar_letter: "U",
            last_message: "Photo",
            timestamp: "13:20",
            is_bot: false,
            is_online: true,
            bubble_color: Theme.dm-bubble,
        },
    ];

    in-out property <[MessageItem]> messages: [
        {
            id: "m-1",
            content: "no absolutely not",
            timestamp: "2:14 PM",
            is_me: true,
            bubble_color: Theme.accent-amber,
        },
        {
            id: "m-2",
            content: "Good! Now stop asking dumb questions and tell me something interesting.",
            timestamp: "2:14 PM",
            is_me: false,
            bubble_color: #fb7185,
        },
        {
            id: "m-3",
            content: "i don't think there is anything interesting in my life",
            timestamp: "2:15 PM",
            is_me: true,
            bubble_color: Theme.accent-amber,
        },
        {
            id: "m-4",
            content: "Tch, boring. Fine, I'll go first. I bought a new skirt today and it looks amazing on me. Not that you'd appreciate it anyway.",
            timestamp: "2:15 PM",
            is_me: false,
            bubble_color: #fb7185,
        },
        {
            id: "m-5",
            content: "I'm sure it looks good 👍",
            timestamp: "2:16 PM",
            is_me: true,
            bubble_color: Theme.accent-amber,
        },
        {
            id: "m-6",
            content: "Obviously it does. I don't need you to tell me that.",
            timestamp: "2:16 PM",
            is_me: false,
            bubble_color: #fb7185,
        },
    ];

    in-out property <[BotCardItem]> bot_directory: [
        {
            id: "nobara",
            name: "Nobara Kugisaki",
            bio: "Student at tokyo high",
            avatar_letter: "N",
            bubble_color: #fb7185,
        },
        {
            id: "fifa",
            name: "Fifa Helper",
            bio: "I know everything about fifa",
            avatar_letter: "F",
            bubble_color: #60a5fa,
        },
        {
            id: "gojo",
            name: "Gojo Satouru",
            bio: "The strongest sorcerer",
            avatar_letter: "G",
            bubble_color: #38bdf8,
        },
    ];

    callback tab-clicked(string);
    callback conversation-selected(string, string, string, string, bool, color);
    callback send-message(string);
    callback accent-changed(string, color);

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // ==========================================
        // LEFT PANE (SIDEBAR: 360px)
        // ==========================================
        Rectangle {
            width: 360px;
            background: Theme.background;

            // Border right
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Theme.border;
            }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // 1. TOP HEADER: RtText + Search + Add Button
                Rectangle {
                    height: 60px;
                    background: Theme.background;

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        alignment: space-between;

                        Text {
                            text: "RtText";
                            color: Theme.text-primary;
                            font-size: 22px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: end;
                            y: (parent.height - 38px) / 2;

                            // Search Icon Button
                            TouchArea {
                                width: 38px;
                                height: 38px;
                                Rectangle {
                                    border-radius: 19px;
                                    background: parent.has-hover ? Theme.surface-high : transparent;
                                    Image {
                                        source: @image-url("../assets/icons/search.svg");
                                        colorize: Theme.text-primary;
                                        width: 18px;
                                        height: 18px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            // Plus FAB Button (Colored with user accent)
                            TouchArea {
                                width: 38px;
                                height: 38px;
                                Rectangle {
                                    border-radius: 14px;
                                    background: root.user-accent-color;
                                    Text {
                                        text: "+";
                                        color: #0b0f14;
                                        font-size: 22px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // 2. NAVIGATION BAR (Chats | Discover | Profile)
                Rectangle {
                    height: 52px;
                    background: Theme.background;

                    Rectangle {
                        x: 12px;
                        width: parent.width - 24px;
                        height: 40px;
                        y: 6px;
                        border-radius: 20px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding: 3px;
                            spacing: 3px;

                            // TAB 1: CHATS
                            TouchArea {
                                horizontal-stretch: 1;
                                clicked => {
                                    root.active-nav = "chats";
                                    root.tab-clicked("chats");
                                }
                                Rectangle {
                                    border-radius: 17px;
                                    background: root.active-nav == "chats" ? #332610 : (parent.has-hover ? #1a222e : transparent);
                                    border-width: root.active-nav == "chats" ? 1px : 0px;
                                    border-color: root.user-accent-color;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;

                                        Image {
                                            source: @image-url("../assets/icons/chat_bubble.svg");
                                            colorize: root.active-nav == "chats" ? root.user-accent-color : Theme.text-subtle;
                                            width: 15px;
                                            height: 15px;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: "Chats";
                                            color: root.active-nav == "chats" ? root.user-accent-color : Theme.text-secondary;
                                            font-size: 13px;
                                            font-weight: root.active-nav == "chats" ? 700 : 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // TAB 2: DISCOVER
                            TouchArea {
                                horizontal-stretch: 1;
                                clicked => {
                                    root.active-nav = "discover";
                                    root.tab-clicked("discover");
                                }
                                Rectangle {
                                    border-radius: 17px;
                                    background: root.active-nav == "discover" ? #332610 : (parent.has-hover ? #1a222e : transparent);
                                    border-width: root.active-nav == "discover" ? 1px : 0px;
                                    border-color: root.user-accent-color;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;

                                        Image {
                                            source: @image-url("../assets/icons/explore.svg");
                                            colorize: root.active-nav == "discover" ? root.user-accent-color : Theme.text-subtle;
                                            width: 15px;
                                            height: 15px;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: "Discover";
                                            color: root.active-nav == "discover" ? root.user-accent-color : Theme.text-secondary;
                                            font-size: 13px;
                                            font-weight: root.active-nav == "discover" ? 700 : 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // TAB 3: PROFILE
                            TouchArea {
                                horizontal-stretch: 1;
                                clicked => {
                                    root.active-nav = "profile";
                                    root.tab-clicked("profile");
                                }
                                Rectangle {
                                    border-radius: 17px;
                                    background: root.active-nav == "profile" ? #332610 : (parent.has-hover ? #1a222e : transparent);
                                    border-width: root.active-nav == "profile" ? 1px : 0px;
                                    border-color: root.user-accent-color;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;

                                        Image {
                                            source: @image-url("../assets/icons/person.svg");
                                            colorize: root.active-nav == "profile" ? root.user-accent-color : Theme.text-subtle;
                                            width: 15px;
                                            height: 15px;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: "Profile";
                                            color: root.active-nav == "profile" ? root.user-accent-color : Theme.text-secondary;
                                            font-size: 13px;
                                            font-weight: root.active-nav == "profile" ? 700 : 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // DIVIDER
                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                // ==========================================
                // SIDEBAR CONTENT: 1. CHATS LIST
                // ==========================================
                if root.active-nav == "chats" : Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: 0px;

                        for conv in root.conversations : touch-item := TouchArea {
                            height: 72px;
                            clicked => {
                                root.active-chat-id = conv.id;
                                root.active-chat-title = conv.title;
                                root.active-chat-subtitle = conv.subtitle;
                                root.active-chat-avatar = conv.avatar-letter;
                                root.active-chat-is-bot = conv.is-bot;
                                root.active-chat-bubble-color = conv.bubble-color;
                                root.conversation-selected(
                                    conv.id,
                                    conv.title,
                                    conv.subtitle,
                                    conv.avatar-letter,
                                    conv.is-bot,
                                    conv.bubble-color
                                );

                                // If selecting human DM, show DM messages with greyish bubbles!
                                if !conv.is-bot && conv.id == "anika" {
                                    root.messages = [
                                        { id: "dm-1", content: "Hi", timestamp: "9:19 AM", is-me: true, bubble-color: root.user-accent-color },
                                        { id: "dm-2", content: "Photo dikh rha hai?", timestamp: "9:19 AM", is-me: true, bubble-color: root.user-accent-color },
                                        { id: "dm-3", content: "nhi", timestamp: "9:30 AM", is-me: false, bubble-color: Theme.dm-bubble },
                                        { id: "dm-4", content: "wi", timestamp: "9:30 AM", is-me: false, bubble-color: Theme.dm-bubble },
                                        { id: "dm-5", content: "w8", timestamp: "9:30 AM", is-me: false, bubble-color: Theme.dm-bubble },
                                        { id: "dm-6", content: "yes", timestamp: "9:31 AM", is-me: false, bubble-color: Theme.dm-bubble },
                                        { id: "dm-7", content: "deal", timestamp: "9:32 AM", is-me: false, bubble-color: Theme.dm-bubble },
                                    ];
                                } else if conv.is-bot {
                                    root.messages = [
                                        { id: "m-1", content: "no absolutely not", timestamp: "2:14 PM", is-me: true, bubble-color: root.user-accent-color },
                                        { id: "m-2", content: "Good! Now stop asking dumb questions and tell me something interesting.", timestamp: "2:14 PM", is-me: false, bubble-color: conv.bubble-color },
                                        { id: "m-3", content: "i don't think there is anything interesting in my life", timestamp: "2:15 PM", is-me: true, bubble-color: root.user-accent-color },
                                        { id: "m-4", content: "Tch, boring. Fine, I'll go first. I bought a new skirt today and it looks amazing on me. Not that you'd appreciate it anyway.", timestamp: "2:15 PM", is-me: false, bubble-color: conv.bubble-color },
                                        { id: "m-5", content: "I'm sure it looks good 👍", timestamp: "2:16 PM", is-me: true, bubble-color: root.user-accent-color },
                                        { id: "m-6", content: "Obviously it does. I don't need you to tell me that.", timestamp: "2:16 PM", is-me: false, bubble-color: conv.bubble-color },
                                    ];
                                }
                            }

                            Rectangle {
                                background: root.active-chat-id == conv.id ? #19202a : (touch-item.has-hover ? #131922 : transparent);

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 14px;

                                    // Avatar circle centered vertically
                                    VerticalLayout {
                                        alignment: center;

                                        Rectangle {
                                            width: 46px;
                                            height: 46px;
                                            border-radius: 23px;
                                            background: Theme.surface-high;
                                            border-width: conv.is-bot ? 1.5px : 0px;
                                            border-color: conv.bubble-color;

                                            Text {
                                                text: conv.avatar-letter;
                                                color: conv.is-bot ? conv.bubble-color : root.user-accent-color;
                                                font-size: 17px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            if conv.is-online : Rectangle {
                                                width: 10px;
                                                height: 10px;
                                                x: 34px;
                                                y: 34px;
                                                border-radius: 5px;
                                                background: #34d399;
                                                border-width: 2px;
                                                border-color: Theme.background;
                                            }
                                        }
                                    }

                                    // Text Column with strict right-aligned meta
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 4px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: conv.title;
                                                horizontal-stretch: 1;
                                                color: Theme.text-primary;
                                                font-size: 14px;
                                                font-weight: 600;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: conv.timestamp;
                                                color: Theme.text-subtle;
                                                font-size: 11px;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: conv.last-message;
                                                horizontal-stretch: 1;
                                                color: Theme.text-secondary;
                                                font-size: 12px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: ">";
                                                color: Theme.text-subtle;
                                                font-size: 11px;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Hairline bottom divider indented past avatar
                                Rectangle {
                                    x: 76px;
                                    width: parent.width - 76px;
                                    y: 71px;
                                    height: 1px;
                                    background: Theme.border-subtle;
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // SIDEBAR CONTENT: 2. DISCOVER
                // ==========================================
                if root.active-nav == "discover" : Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 16px;
                        alignment: start;

                        // Segmented pill
                        Rectangle {
                            height: 38px;
                            border-radius: Theme.radius-pill;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;

                                TouchArea {
                                    horizontal-stretch: 1;
                                    clicked => { root.discover-subnav = "characters"; }
                                    Rectangle {
                                        border-radius: Theme.radius-pill;
                                        background: root.discover-subnav == "characters" ? #3d2c10 : transparent;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/icons/sparkle.svg");
                                                width: 14px;
                                                height: 14px;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: "Characters";
                                                color: root.discover-subnav == "characters" ? root.user-accent-color : Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                TouchArea {
                                    horizontal-stretch: 1;
                                    clicked => { root.discover-subnav = "people"; }
                                    Rectangle {
                                        border-radius: Theme.radius-pill;
                                        background: root.discover-subnav == "people" ? #3d2c10 : transparent;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            Image {
                                                source: @image-url("../assets/icons/person.svg");
                                                colorize: root.discover-subnav == "people" ? root.user-accent-color : Theme.text-secondary;
                                                width: 14px;
                                                height: 14px;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                text: "People";
                                                color: root.discover-subnav == "people" ? root.user-accent-color : Theme.text-secondary;
                                                font-size: 12px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Search box
                        Rectangle {
                            height: 40px;
                            border-radius: Theme.radius-pill;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 10px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/search.svg");
                                    colorize: Theme.text-subtle;
                                    width: 16px;
                                    height: 16px;
                                }

                                Text {
                                    text: "Search characters...";
                                    color: Theme.text-subtle;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Bot Cards
                        for bot in root.bot_directory : touch-bot := TouchArea {
                            height: 84px;
                            clicked => {
                                root.active-chat-id = bot.id;
                                root.active-chat-title = bot.name;
                                root.active-chat-subtitle = bot.bio;
                                root.active-chat-avatar = bot.avatar-letter;
                                root.active-chat-is-bot = true;
                                root.active-chat-bubble-color = bot.bubble-color;
                                root.active-nav = "chats";
                            }

                            Rectangle {
                                border-radius: Theme.radius-lg;
                                background: touch-bot.has-hover ? #19202a : Theme.card;
                                border-width: 1px;
                                border-color: Theme.border;

                                HorizontalLayout {
                                    padding: 14px;
                                    spacing: 14px;

                                    VerticalLayout {
                                        alignment: center;

                                        Rectangle {
                                            width: 48px;
                                            height: 48px;
                                            border-radius: 24px;
                                            background: Theme.surface-high;
                                            border-width: 1.5px;
                                            border-color: bot.bubble-color;
                                            Text {
                                                text: bot.avatar-letter;
                                                color: bot.bubble-color;
                                                font-size: 18px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 3px;
                                        Text {
                                            text: bot.name;
                                            color: Theme.text-primary;
                                            font-size: 14px;
                                            font-weight: 700;
                                        }
                                        Text {
                                            text: bot.bio;
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // SIDEBAR CONTENT: 3. PROFILE (Matching Screenshot 3 & 4)
                // ==========================================
                if root.active-nav == "profile" : Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 16px;
                        alignment: start;

                        // Profile Header with Avatar & Username
                        Rectangle {
                            height: 110px;
                            border-radius: Theme.radius-lg;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: 14px;
                                alignment: center;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 14px;
                                    alignment: center;

                                    Rectangle {
                                        width: 52px;
                                        height: 52px;
                                        border-radius: 26px;
                                        background: Theme.surface-high;
                                        border-width: 1.5px;
                                        border-color: root.user-accent-color;
                                        Text {
                                            text: "L";
                                            color: root.user-accent-color;
                                            font-size: 20px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: root.current-username;
                                            color: Theme.text-primary;
                                            font-size: 16px;
                                            font-weight: 700;
                                        }
                                        Text {
                                            text: "@" + root.current-username;
                                            color: Theme.text-subtle;
                                            font-size: 12px;
                                        }
                                        Text {
                                            text: "Joined October 2026";
                                            color: Theme.text-subtle;
                                            font-size: 11px;
                                        }
                                    }
                                }
                            }
                        }

                        // BEAD BALANCE CARD (Screenshot 3)
                        Rectangle {
                            height: 72px;
                            border-radius: Theme.radius-lg;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 20px;
                                alignment: center;
                                spacing: 14px;

                                Image {
                                    source: @image-url("../assets/icons/bead.svg");
                                    width: 38px;
                                    height: 38px;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "\{root.bead-balance}";
                                    color: root.user-accent-color;
                                    font-size: 26px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "beads";
                                    color: Theme.text-secondary;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // APPEARANCE COLOR SWATCHES (Screenshot 3 - Interactive!)
                        Rectangle {
                            height: 110px;
                            border-radius: Theme.radius-lg;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 14px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Image {
                                        source: @image-url("../assets/icons/palette.svg");
                                        colorize: Theme.text-primary;
                                        width: 16px;
                                        height: 16px;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Appearance (Sets your bubble & theme color)";
                                        color: Theme.text-primary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: space-around;

                                    // Swatch 1: Teal
                                    TouchArea {
                                        width: 32px; height: 32px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-teal;
                                            root.user-accent-id = "teal";
                                            root.accent-changed("teal", Theme.accent-teal);
                                        }
                                        Rectangle {
                                            border-radius: 16px;
                                            background: Theme.accent-teal;
                                            if root.user-accent-id == "teal" : Text { text: "✓"; color: #0b0f14; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }

                                    // Swatch 2: Violet
                                    TouchArea {
                                        width: 32px; height: 32px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-violet;
                                            root.user-accent-id = "violet";
                                            root.accent-changed("violet", Theme.accent-violet);
                                        }
                                        Rectangle {
                                            border-radius: 16px;
                                            background: Theme.accent-violet;
                                            if root.user-accent-id == "violet" : Text { text: "✓"; color: #0b0f14; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }

                                    // Swatch 3: Rose
                                    TouchArea {
                                        width: 32px; height: 32px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-rose;
                                            root.user-accent-id = "rose";
                                            root.accent-changed("rose", Theme.accent-rose);
                                        }
                                        Rectangle {
                                            border-radius: 16px;
                                            background: Theme.accent-rose;
                                            if root.user-accent-id == "rose" : Text { text: "✓"; color: #0b0f14; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }

                                    // Swatch 4: Amber (Default)
                                    TouchArea {
                                        width: 32px; height: 32px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-amber;
                                            root.user-accent-id = "amber";
                                            root.accent-changed("amber", Theme.accent-amber);
                                        }
                                        Rectangle {
                                            border-radius: 16px;
                                            background: Theme.accent-amber;
                                            if root.user-accent-id == "amber" : Text { text: "✓"; color: #0b0f14; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }

                                    // Swatch 5: Blue
                                    TouchArea {
                                        width: 32px; height: 32px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-blue;
                                            root.user-accent-id = "blue";
                                            root.accent-changed("blue", Theme.accent-blue);
                                        }
                                        Rectangle {
                                            border-radius: 16px;
                                            background: Theme.accent-blue;
                                            if root.user-accent-id == "blue" : Text { text: "✓"; color: #0b0f14; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }

                                    // Swatch 6: Green
                                    TouchArea {
                                        width: 32px; height: 32px;
                                        clicked => {
                                            root.user-accent-color = Theme.accent-green;
                                            root.user-accent-id = "green";
                                            root.accent-changed("green", Theme.accent-green);
                                        }
                                        Rectangle {
                                            border-radius: 16px;
                                            background: Theme.accent-green;
                                            if root.user-accent-id == "green" : Text { text: "✓"; color: #0b0f14; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        // APP UPDATES CARD
                        Rectangle {
                            height: 72px;
                            border-radius: Theme.radius-lg;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "App updates";
                                        color: Theme.text-primary;
                                        font-size: 14px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: "Desktop v0.2.1 • System Tray Active";
                                        color: Theme.text-subtle;
                                        font-size: 11px;
                                    }
                                }

                                Rectangle {
                                    width: 80px;
                                    height: 32px;
                                    border-radius: Theme.radius-pill;
                                    border-width: 1px;
                                    border-color: root.user-accent-color;
                                    Text {
                                        text: "Latest";
                                        color: root.user-accent-color;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==========================================
        // RIGHT PANE (ACTIVE CHAT)
        // ==========================================
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.background;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // 1. CHAT HEADER
                Rectangle {
                    height: 60px;
                    background: Theme.surface;

                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;

                            // Avatar
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: Theme.surface-high;
                                border-width: root.active-chat-is-bot ? 1.5px : 0px;
                                border-color: root.active-chat-bubble-color;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: root.active-chat-avatar;
                                    color: root.active-chat-is-bot ? root.active-chat-bubble-color : root.user-accent-color;
                                    font-size: 16px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Title & Subtitle
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: root.active-chat-title;
                                    color: Theme.text-primary;
                                    font-size: 15px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: root.active-chat-subtitle;
                                    color: Theme.text-secondary;
                                    font-size: 12px;
                                }
                            }
                        }

                        // Right Icon (Robot head for bots, Info circle for DMs)
                        HorizontalLayout {
                            alignment: end;
                            y: (parent.height - 24px) / 2;

                            if root.active-chat-is-bot : Image {
                                source: @image-url("../assets/icons/robot.svg");
                                colorize: Theme.text-secondary;
                                width: 22px;
                                height: 22px;
                            }

                            if !root.active-chat-is-bot : Image {
                                source: @image-url("../assets/icons/info.svg");
                                colorize: Theme.text-secondary;
                                width: 22px;
                                height: 22px;
                            }
                        }
                    }
                }

                // 2. MESSAGES FEED (Hugging Content)
                Flickable {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        alignment: start;

                        for msg in root.messages : HorizontalLayout {
                            alignment: msg.is-me ? end : start;

                            Rectangle {
                                border-radius: 16px;
                                background: msg.is-me ? root.user-accent-color : msg.bubble-color;

                                VerticalLayout {
                                    padding-top: 8px;
                                    padding-bottom: 6px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 3px;

                                    Text {
                                        text: msg.content;
                                        color: msg.is-me ? #0b0f14 : #ffffff;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                        max-width: 440px;
                                    }

                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 4px;

                                        Text {
                                            text: msg.timestamp;
                                            color: msg.is-me ? #0b0f14aa : #ffffffaa;
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }

                                        if msg.is-me : Image {
                                            source: @image-url("../assets/icons/checkmarks.svg");
                                            width: 14px;
                                            height: 9px;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 3. BOTTOM INPUT DOCK (Photo Attach + Input Box + Send)
                Rectangle {
                    height: 68px;
                    background: Theme.surface;

                    Rectangle {
                        y: 0px;
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        alignment: center;

                        // Image attachment icon button
                        TouchArea {
                            width: 38px;
                            height: 38px;
                            Rectangle {
                                border-radius: 19px;
                                background: parent.has-hover ? Theme.surface-high : transparent;
                                Image {
                                    source: @image-url("../assets/icons/image_attach.svg");
                                    colorize: Theme.text-secondary;
                                    width: 22px;
                                    height: 22px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        // Message Input Field
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 44px;
                            border-radius: 22px;
                            background: Theme.surface-high;
                            border-width: 1px;
                            border-color: Theme.border;

                            if root.draft-text == "" : Text {
                                x: 18px;
                                text: "Message...";
                                color: Theme.text-subtle;
                                font-size: 13px;
                                vertical-alignment: center;
                            }

                            TextInput {
                                x: 18px;
                                width: parent.width - 36px;
                                height: 44px;
                                text <=> root.draft-text;
                                color: Theme.text-primary;
                                font-size: 13px;
                                vertical-alignment: center;
                                accepted => {
                                    if (root.draft-text != "") {
                                        root.send-message(root.draft-text);
                                        root.draft-text = "";
                                    }
                                }
                            }
                        }

                        // Send paper plane button
                        touch-send := TouchArea {
                            width: 44px;
                            height: 44px;
                            clicked => {
                                if (root.draft-text != "") {
                                    root.send-message(root.draft-text);
                                    root.draft-text = "";
                                }
                            }

                            Rectangle {
                                border-radius: 22px;
                                background: root.draft-text != "" ? root.user-accent-color : #232b38;

                                Image {
                                    source: @image-url("../assets/icons/send.svg");
                                    colorize: root.draft-text != "" ? #0b0f14 : Theme.text-secondary;
                                    width: 18px;
                                    height: 18px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
