export global Theme {
    out property <color> background: #0b0f14;
    out property <color> surface: #11161d;
    out property <color> surface-high: #1a212b;
    out property <color> card: #151b23;
    out property <color> border: #212936;
    out property <color> border-subtle: #18202b;

    // Active accent: Amber from screenshot (#FBBF24 / #E5A93C)
    out property <color> primary: #fbbf24;
    out property <color> primary-dark: #d97706;
    out property <color> primary-container: #453011;
    out property <color> on-primary: #0b0f14;

    // Bot custom bubble colors
    out property <color> bot-nobara: #fb7185;
    out property <color> bot-gojo: #38bdf8;

    out property <color> text-primary: #ffffff;
    out property <color> text-secondary: #94a3b8;
    out property <color> text-subtle: #64748b;

    out property <length> radius-sm: 8px;
    out property <length> radius-md: 12px;
    out property <length> radius-lg: 16px;
    out property <length> radius-pill: 999px;
}
